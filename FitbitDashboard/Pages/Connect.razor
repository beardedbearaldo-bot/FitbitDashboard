@page "/"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Sports Analytics Hub</h3>
<p>Connect your wearable devices to begin generating training load metrics.</p>

<button class="btn btn-primary" @onclick="ConnectFitbit">
    🔄 Connect My Fitbit
</button>

@code {
    private async Task ConnectFitbit()
    {
        try
        {
            // Call your API to get the structured Fitbit login URL
            var response = await Http.GetFromJsonAsync<LoginUrlResponse>("api/auth/fitbit-login-url");

            if (response != null && !string.IsNullOrEmpty(response.Url))
            {
                // Force break out of Blazor and navigate the browser to Fitbit's OAuth screen
                Navigation.NavigateTo(response.Url, forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing OAuth sequence: {ex.Message}");
        }
    }

    private class LoginUrlResponse
    {
        public string? Url { get; set; }
    }
}

